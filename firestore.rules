rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRole(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r;
    }

    function shopStatus(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.status;
    }

    // Delivery charge + minimum order are the SHOP's own settings (shops/{id}.delivery). Orders must use them
    // exactly: a customer cannot pick a smaller fee or skip the minimum. Missing settings mean 0 / 0.
    function shopDelivery(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.get('delivery', {});
    }
    // An explicit isOpen=false or delivery.suspended=true blocks new orders on the server too (not just in the UI).
    function shopAcceptsOrders(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.get('isOpen', true) == true
        && shopDelivery(shopId).get('suspended', false) == false;
    }
    function feeFor(shopId) {
      return shopDelivery(shopId).get('deliveryFee', 0);
    }
    function minFor(shopId) {
      return shopDelivery(shopId).get('minimumOrderAmount', 0);
    }
    // Phone is VERIFIED when the sign-in token carries a phone_number (set by Firebase after an SMS OTP).
    function phoneVerified() {
      return signedIn() && 'phone_number' in request.auth.token;
    }
    function ownsPhone(p10) {
      return phoneVerified() && request.auth.token.phone_number == '+91' + p10;
    }
    function profileOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Nearby / delivery settings a shopkeeper may keep on their own approved shop (Phase 3).
    function validLocation(l) {
      return l is map
        && l.keys().hasOnly(['latitude','longitude'])
        && l.latitude is number && l.latitude >= -90 && l.latitude <= 90
        && l.longitude is number && l.longitude >= -180 && l.longitude <= 180;
    }

    function validDelivery(d) {
      return d is map
        && d.keys().hasOnly(['enabled','radiusKm','deliveryFee','minimumOrderAmount',
                             'estimatedPreparationMinutes','suspended'])
        && (!('enabled' in d) || d.enabled is bool)
        && (!('suspended' in d) || d.suspended is bool)
        && (!('radiusKm' in d) || (d.radiusKm is number && d.radiusKm > 0 && d.radiusKm <= 50))
        && (!('deliveryFee' in d) || (d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee <= 500))
        && (!('minimumOrderAmount' in d) || (d.minimumOrderAmount is number && d.minimumOrderAmount >= 0 && d.minimumOrderAmount <= 10000))
        && (!('estimatedPreparationMinutes' in d)
            || (d.estimatedPreparationMinutes is int && d.estimatedPreparationMinutes >= 0 && d.estimatedPreparationMinutes <= 240));
    }

    function validProduct(d) {
      return d.keys().hasOnly(['name','price','unit','stock','active','createdAt','lastOrderId','image'])
        && (!('image' in d)
            || (d.image is string
                && d.image.size() <= 40000
                && d.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && d.name is string
        && d.name.size() >= 2 && d.name.size() <= 80
        && d.price is number
        && d.price > 0 && d.price <= 100000
        && d.unit in ['kg','g','litre','piece','packet','dozen','pair','box','metre']
        && d.stock is int
        && d.stock >= 0 && d.stock <= 100000
        && d.active is bool
        && (!('lastOrderId' in d) || d.lastOrderId is string);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','role','status','createdAt'])
        && request.resource.data.role in ['customer','shopkeeper']
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && ownsPhone(request.resource.data.phone);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['name','phone','role','status','createdAt','address'])
        && (request.resource.data.phone == resource.data.phone || ownsPhone(request.resource.data.phone))
        && (!('address' in request.resource.data)
            || (request.resource.data.address is string
                && request.resource.data.address.size() >= 5
                && request.resource.data.address.size() <= 200));
    }

    match /shops/{shopId} {
      allow create: if isRole('shopkeeper')
        && phoneVerified()
        && request.auth.uid == shopId
        && request.resource.data.keys().hasOnly(
             ['ownerUid','name','address','category','phone','status','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 200
        && request.resource.data.category in
             ['kirana','sabzi-fruit','dairy','bakery','sweets','restaurant','medical',
              'clothes','footwear','electronics','hardware','stationery','salon',
              'jewellery','pooja','agri','other']
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$');

      allow read: if (signedIn() && request.auth.uid == shopId)
        || resource.data.status == 'approved'
        || isRole('admin');

      allow update: if isRole('admin')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved','rejected','pending'];

      allow update: if isRole('shopkeeper')
        && request.auth.uid == shopId
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpen','location','delivery'])
        && (!('isOpen' in request.resource.data) || request.resource.data.isOpen is bool)
        && (!('location' in request.resource.data) || validLocation(request.resource.data.location))
        && (!('delivery' in request.resource.data) || validDelivery(request.resource.data.delivery));

      allow delete: if false;

      match /products/{productId} {
        allow read: if (signedIn() && request.auth.uid == shopId)
          || (resource.data.active == true && shopStatus(shopId) == 'approved')
          || isRole('admin');

        allow create: if isRole('shopkeeper')
          && request.auth.uid == shopId
          && shopStatus(shopId) == 'approved'
          && validProduct(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if isRole('shopkeeper')
          && request.auth.uid == shopId
          && shopStatus(shopId) == 'approved'
          && validProduct(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','lastOrderId'])
          && request.resource.data.lastOrderId is string
          && !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId))
          && oAfter(request.resource.data.lastOrderId).customerUid == request.auth.uid
          && oAfter(request.resource.data.lastOrderId).shopId == shopId
          && qtyIn(oAfter(request.resource.data.lastOrderId).items, productId) >= 1
          && request.resource.data.stock >= 0
          && request.resource.data.stock ==
               resource.data.stock - qtyIn(oAfter(request.resource.data.lastOrderId).items, productId);

        allow delete: if false;
      }
    }

    function pdoc(shopId, items, n) {
      return get(/databases/$(database)/documents/shops/$(shopId)/products/$(items[n].productId)).data;
    }

    function itemOk(shopId, items, n) {
      return items.size() <= n
        || (items[n].keys().hasOnly(['productId','name','price','unit','qty'])
            && items[n].qty is int && items[n].qty >= 1 && items[n].qty <= 20
            && pdoc(shopId, items, n).active == true
            && pdoc(shopId, items, n).name == items[n].name
            && pdoc(shopId, items, n).price == items[n].price
            && pdoc(shopId, items, n).unit == items[n].unit
            && pdoc(shopId, items, n).stock >= items[n].qty);
    }

    function oAfter(oid) {
      return getAfter(/databases/$(database)/documents/orders/$(oid)).data;
    }

    function qtyIn(items, pid) {
      return (items.size() > 0 && items[0].productId == pid) ? items[0].qty
        : (items.size() > 1 && items[1].productId == pid) ? items[1].qty
        : (items.size() > 2 && items[2].productId == pid) ? items[2].qty
        : (items.size() > 3 && items[3].productId == pid) ? items[3].qty
        : (items.size() > 4 && items[4].productId == pid) ? items[4].qty
        : 0;
    }

    function neq(items, i, j) {
      return items.size() <= j || items[i].productId != items[j].productId;
    }

    function distinct(items) {
      return neq(items,0,1) && neq(items,0,2) && neq(items,0,3) && neq(items,0,4)
        && neq(items,1,2) && neq(items,1,3) && neq(items,1,4)
        && neq(items,2,3) && neq(items,2,4) && neq(items,3,4);
    }

    function line(items, n) {
      return items.size() > n ? items[n].price * items[n].qty : 0;
    }

    match /orders/{orderId} {
      allow create: if isRole('customer')
        && phoneVerified()
        && request.resource.data.keys().hasOnly(
             ['customerUid','shopId','shopName','items','subtotal','deliveryFee','total','address','phone','paymentMethod','status','createdAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.paymentMethod == 'COD'
        && request.resource.data.createdAt == request.time
        && shopStatus(request.resource.data.shopId) == 'approved'
        && shopAcceptsOrders(request.resource.data.shopId)
        && request.resource.data.shopName ==
             get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.name
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 5
        && distinct(request.resource.data.items)
        && request.resource.data.subtotal ==
             line(request.resource.data.items, 0) + line(request.resource.data.items, 1)
             + line(request.resource.data.items, 2) + line(request.resource.data.items, 3)
             + line(request.resource.data.items, 4)
        && request.resource.data.deliveryFee == feeFor(request.resource.data.shopId)
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryFee
        && request.resource.data.subtotal >= minFor(request.resource.data.shopId)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 0)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 1)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 2)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 3)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 4);

      // Riders see the open pool (status == accepted: accepting an order and claiming it are one step,
      // so an `accepted` order never has a rider yet) and the orders they claimed themselves.
      allow read: if (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.shopId == request.auth.uid)
        || (isRole('delivery')
            && (resource.data.status == 'accepted'
                || resource.data.get('deliveryBoyId', '') == request.auth.uid))
        || isRole('admin');

      // Shopkeeper: accept / reject only. Handing over to a rider and delivering are the rider's moves.
      // Customer: cancel while still `placed`.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.shopId == request.auth.uid
            && isRole('shopkeeper')
            && resource.data.status == 'placed'
            && request.resource.data.status in ['accepted','rejected'])
          || (resource.data.customerUid == request.auth.uid
            && resource.data.status == 'placed'
            && request.resource.data.status == 'cancelled')
        );

      // Rider claims an accepted order: status -> out_for_delivery and deliveryBoyId = self in ONE write.
      // The second rider to tap loses: by then the order is no longer `accepted`.
      allow update: if isRole('delivery')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','deliveryBoyId','riderName','riderPhone'])
        && resource.data.status == 'accepted'
        && !('deliveryBoyId' in resource.data)
        && request.resource.data.status == 'out_for_delivery'
        && request.resource.data.deliveryBoyId == request.auth.uid
        && request.resource.data.riderName == profileOf(request.auth.uid).name
        && request.resource.data.riderPhone == profileOf(request.auth.uid).phone;

      // Only the rider who holds the order can mark it delivered.
      allow update: if isRole('delivery')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.get('deliveryBoyId', '') == request.auth.uid
        && resource.data.status == 'out_for_delivery'
        && request.resource.data.status == 'delivered';

      allow delete: if false;
    }

    // ---- order reviews: reviews/{orderId} (one per order, written from modules/customer/rate-order.js)
    // Step 1 (emoji) creates the doc with detailsDone=false; "Tell us More" fills the rest and sets
    // detailsDone=true, after which it is locked. Shopkeepers can read reviews of their own shop.
    function rOk(l, n) {
      return l.size() <= n || (l[n] is int && l[n] >= 0 && l[n] <= 5);
    }

    function validReview(d) {
      return d.keys().hasOnly(['orderId','customerUid','shopId','rating','tags','comment',
                               'shopRating','itemRatings','detailsDone','createdAt'])
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.tags is list && d.tags.size() <= 5
        && d.tags.hasOnly(['quality','speed','packaging','price','behaviour'])
        && d.comment is string && d.comment.size() <= 300
        && d.shopRating is int && d.shopRating >= 0 && d.shopRating <= 5
        && d.itemRatings is list && d.itemRatings.size() <= 5
        && rOk(d.itemRatings, 0) && rOk(d.itemRatings, 1) && rOk(d.itemRatings, 2)
        && rOk(d.itemRatings, 3) && rOk(d.itemRatings, 4)
        && d.detailsDone is bool;
    }

    match /reviews/{orderId} {
      allow create: if isRole('customer')
        && validReview(request.resource.data)
        && request.resource.data.orderId == orderId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.detailsDone == false
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.shopId == request.resource.data.shopId
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered';

      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid
            || resource.data.shopId == request.auth.uid
            || isRole('admin'));

      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.detailsDone == false
        && validReview(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rating','tags','comment','shopRating','itemRatings','detailsDone'])
        && (request.resource.data.itemRatings.size() == 0
            || request.resource.data.itemRatings.size()
               == get(/databases/$(database)/documents/orders/$(orderId)).data.items.size());

      allow delete: if false;
    }

    // ---- money: written ONLY by Cloud Functions (Admin SDK bypasses rules). Clients can only read their own.
    match /ledger/{orderId} {
      allow read: if signedIn() && (resource.data.shopId == request.auth.uid || isRole('admin'));
      allow write: if false;
    }

    match /wallets/{shopId} {
      allow read: if signedIn() && (request.auth.uid == shopId || isRole('admin'));
      allow write: if false;
    }

    // ---- role-change audit trail: written ONLY by the setDeliveryRole Cloud Function (Admin SDK bypasses rules).
    // No client (not even admin) can read or write it from the browser.
    match /roleAudit/{auditId} {
      allow read, write: if false;
    }

    match /feedback/{fid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','role','rating','comment','lang','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['customer','shopkeeper','admin']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 300
        && request.resource.data.lang in ['hi','en']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
