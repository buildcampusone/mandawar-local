rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRole(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r;
    }

    function shopStatus(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.status;
    }

    function validProduct(d) {
      return d.keys().hasOnly(['name','price','unit','stock','active','createdAt','lastOrderId'])
        && d.name is string
        && d.name.size() >= 2 && d.name.size() <= 80
        && d.price is number
        && d.price > 0 && d.price <= 100000
        && d.unit in ['kg','g','litre','piece','packet','dozen','pair','box','metre']
        && d.stock is int
        && d.stock >= 0 && d.stock <= 100000
        && d.active is bool
        && (!('lastOrderId' in d) || d.lastOrderId is string);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','role','status','createdAt'])
        && request.resource.data.role in ['customer','shopkeeper']
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['name','phone','role','status','createdAt','address'])
        && (!('address' in request.resource.data)
            || (request.resource.data.address is string
                && request.resource.data.address.size() >= 5
                && request.resource.data.address.size() <= 200));
    }

    match /shops/{shopId} {
      allow create: if isRole('shopkeeper')
        && request.auth.uid == shopId
        && request.resource.data.keys().hasOnly(
             ['ownerUid','name','address','category','phone','status','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 200
        && request.resource.data.category in
             ['kirana','sabzi-fruit','dairy','bakery','sweets','restaurant','medical',
              'clothes','footwear','electronics','hardware','stationery','salon',
              'jewellery','pooja','agri','other']
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$');

      allow read: if (signedIn() && request.auth.uid == shopId)
        || resource.data.status == 'approved'
        || isRole('admin');

      allow update: if isRole('admin')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved','rejected','pending'];

      allow delete: if false;

      match /products/{productId} {
        allow read: if (signedIn() && request.auth.uid == shopId)
          || (resource.data.active == true && shopStatus(shopId) == 'approved')
          || isRole('admin');

        allow create: if isRole('shopkeeper')
          && request.auth.uid == shopId
          && shopStatus(shopId) == 'approved'
          && validProduct(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if isRole('shopkeeper')
          && request.auth.uid == shopId
          && shopStatus(shopId) == 'approved'
          && validProduct(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','lastOrderId'])
          && request.resource.data.lastOrderId is string
          && !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId))
          && oAfter(request.resource.data.lastOrderId).customerUid == request.auth.uid
          && oAfter(request.resource.data.lastOrderId).shopId == shopId
          && qtyIn(oAfter(request.resource.data.lastOrderId).items, productId) >= 1
          && request.resource.data.stock >= 0
          && request.resource.data.stock ==
               resource.data.stock - qtyIn(oAfter(request.resource.data.lastOrderId).items, productId);

        allow delete: if false;
      }
    }

    function pdoc(shopId, items, n) {
      return get(/databases/$(database)/documents/shops/$(shopId)/products/$(items[n].productId)).data;
    }

    function itemOk(shopId, items, n) {
      return items.size() <= n
        || (items[n].keys().hasOnly(['productId','name','price','unit','qty'])
            && items[n].qty is int && items[n].qty >= 1 && items[n].qty <= 20
            && pdoc(shopId, items, n).active == true
            && pdoc(shopId, items, n).name == items[n].name
            && pdoc(shopId, items, n).price == items[n].price
            && pdoc(shopId, items, n).unit == items[n].unit
            && pdoc(shopId, items, n).stock >= items[n].qty);
    }

    function oAfter(oid) {
      return getAfter(/databases/$(database)/documents/orders/$(oid)).data;
    }

    function qtyIn(items, pid) {
      return (items.size() > 0 && items[0].productId == pid) ? items[0].qty
        : (items.size() > 1 && items[1].productId == pid) ? items[1].qty
        : (items.size() > 2 && items[2].productId == pid) ? items[2].qty
        : (items.size() > 3 && items[3].productId == pid) ? items[3].qty
        : (items.size() > 4 && items[4].productId == pid) ? items[4].qty
        : 0;
    }

    function neq(items, i, j) {
      return items.size() <= j || items[i].productId != items[j].productId;
    }

    function distinct(items) {
      return neq(items,0,1) && neq(items,0,2) && neq(items,0,3) && neq(items,0,4)
        && neq(items,1,2) && neq(items,1,3) && neq(items,1,4)
        && neq(items,2,3) && neq(items,2,4) && neq(items,3,4);
    }

    function line(items, n) {
      return items.size() > n ? items[n].price * items[n].qty : 0;
    }

    match /orders/{orderId} {
      allow create: if isRole('customer')
        && request.resource.data.keys().hasOnly(
             ['customerUid','shopId','shopName','items','total','address','phone','paymentMethod','status','createdAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.paymentMethod == 'COD'
        && request.resource.data.createdAt == request.time
        && shopStatus(request.resource.data.shopId) == 'approved'
        && request.resource.data.shopName ==
             get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.name
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 5
        && distinct(request.resource.data.items)
        && request.resource.data.total ==
             line(request.resource.data.items, 0) + line(request.resource.data.items, 1)
             + line(request.resource.data.items, 2) + line(request.resource.data.items, 3)
             + line(request.resource.data.items, 4)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 0)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 1)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 2)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 3)
        && itemOk(request.resource.data.shopId, request.resource.data.items, 4);

      allow read: if (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.shopId == request.auth.uid)
        || isRole('admin');

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.shopId == request.auth.uid
            && isRole('shopkeeper')
            && ((resource.data.status == 'placed'
                  && request.resource.data.status in ['accepted','rejected'])
                || (resource.data.status == 'accepted'
                  && request.resource.data.status == 'out_for_delivery')
                || (resource.data.status == 'out_for_delivery'
                  && request.resource.data.status == 'delivered')))
          || (resource.data.customerUid == request.auth.uid
            && resource.data.status == 'placed'
            && request.resource.data.status == 'cancelled')
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
